    def yaml_data = readYAML(file(params.yaml))

    // not sure if that's the right syntax - don't throw error if PACBIO_SMRT reads can't be found
    pacbio_samples = yaml_data.reads?.PACBIO_SMRT

    if ( !pacbio_samples ) { 

